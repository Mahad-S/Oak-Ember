8 3.564.173 3.564-1.67"></path></svg><svg width="24" height="24" fill="black" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M6.336 6.177v11.646c0 1.843 2.15 2.85 3.565 1.668l6.982-5.826a2.173 2.173 0 0 0-.001-3.337L9.9 4.508c-1.415-1.18-3.564-.173-3.564 1.67"></path></svg></div></img-comparison-slider></div></div></div></div></div><div class="landing-section-wrapper bg-background" style="content-visibility:auto;contain-intrinsic-size:auto 500px"><hr class="w-full border-0 bg-background h-8 md:h-14" data-testid="divider"></div><div class="landing-section-wrapper bg-background" style="content-visibility:auto;contain-intrinsic-size:auto 500px"><div class="relative bg-background flex flex-1 min-h-[210px] z-[2]" data-testid="banner-block" data-pulse-section-group="-ai-image-enhancer-unpixelate-image-_banner-block" id="17_132693_banner-block"><div class="container-root grid items-center gap-16 grid-cols-[5fr_7fr] max-md:mt-10 max-md:flex max-md:!flex-col-reverse max-md:gap-8" data-testid="container"><div class="z-[2] flex flex-1 flex-col gap-6 max-md:items-center" data-testid="banner-block-copy"><h2 id="212653" class="text-[42px] leading-[50px] font-semibold max-[768px]:text-[32px] max-[768px]:leading-[40px] break-words text-light max-md:text-center" data-testid="heading-title"><span>Keep finessing with Picsart’s AI photo editor</span></h2><div class="Description-description-f9d64 Description-sizeLarge-4f730 max-md:text-center font-medium text-light [&amp;_ul]:my-4 [&amp;_ul]:list-disc [&amp;_ul]:space-y-3 [&amp;_ul]:pl-6 [&amp;_li]:pl-2 [&amp;_li::marker]:text-accent-pink" data-testid="description-root"><p>Access an all-inclusive set of tools with Picsart’s&nbsp;<a href="https://picsart.com/ai-photo-editor/" rel="noopener">AI photo editor</a>. Conveniently perform easy tweaks like&nbsp;<a href="https://picsart.com/flip-image/" rel="noopener">flipping images</a>, to more complex edits like expanding your image beyond its original borders with the&nbsp;<a href="https://picsart.com/ai-image-extender/" rel="noopener">image extender</a> tool. All this and so much more, available to you in a convenient online interface that doesn’t require any downloads.&nbsp;</p></div></div><div class="z-[1] flex w-full justify-start order-first max-md:!justify-center max-md:!order-none" data-testid="media-root"><div class="relative w-[480px] aspect-square overflow-hidden max-[1365px]:max-w-[447px] max-[1279px]:max-w-[340px] max-[1023px]:max-w-[243px] max-[767px]:max-w-[424px] max-[767px]:mt-10 max-[480px]:max-w-[319px] "><video src="https://cdn-cms-uploads.picsart.com/cms-uploads/f183d289-447d-46c5-a2ca-7b5c40304c0c.webm" autoplay="" loop="" muted="" playsinline="" poster="https://cdn-cms-uploads.picsart.com/cms-uploads/78794ffc-69d6-4517-b2d1-a89f65d46135.webp" class="h-full w-full object-contain "></video></div></div></div></div></div><div class="landing-section-wrapper bg-background" style="content-visibility:auto;contain-intrinsic-size:auto 500px"><hr class="w-full border-0 bg-background h-8 md:h-14" data-testid="divider"></div><div class="landing-section-wrapper bg-background" style="content-visibility:auto;contain-intrinsic-size:auto 500px"><div class="py-16 max-md:py-10" data-pulse-section-group="19_5085_testimonial-cards"><div class="container-root flex flex-col items-center" data-testid="container"><div class="w-full max-w-[1282px] mx-auto"><div class="flex overflow-x-auto scrollbar-hide max-md:gap-4 max-md:snap-x max-md:snap-mandatory pb-4"><div class="flex justify-between flex-col h-auto mx-auto text-center px-3 w-full max-md:w-[75%] max-md:snap-center max-md:shrink-0"><div class="relative bg-[var(--background-colors-tint-1)] p-4 rounded-2xl flex-1"><svg width="24" height="24" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="quote-icon mb-6 block w-9 h-9 [&amp;&gt;path]:fill-[var(--primary-colors-base-default)]"><path d="M21.99 2.66a.74.74 0 0 1-.143.576.88.88 0 0 1-.506.313q-2.21.36-3.46 1.08-1.249